# ============================================================
# IONDU · Variables de entorno (PLANTILLA, sin secretos)
# - En local: copiar a .env (está en .gitignore).
# - En producción: se cargan en el panel del despliegue (Coolify u otro).
# ============================================================

# ---------- Angular (solo build) ----------
NG_BUILD_CONFIGURATION=production
NG_APP_NAME=iondu-app

# ---------- Backend ----------
# production | development (en development se habilita /api/docs)
APP_ENV=production
LOG_LEVEL=info
# Solo si se usa `ng serve` contra la API; en producción todo es mismo origen.
CORS_ORIGINS=

# ---------- PostgreSQL local (solo desarrollo, docker-compose.override.yml) ----------
# Obligatoria en local. Cualquier valor sin caracteres especiales, por ejemplo
# uno generado con: python -c "import secrets; print(secrets.token_hex(16))"
# Desde la computadora se conecta en localhost:15432 (usuario y base: iondu).
POSTGRES_PASSWORD=

# ---------- Supabase (se completan en el Sprint 1) ----------
# Usar el Session Pooler (puerto 5432):
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Si se deja vacía en local, se usa el PostgreSQL local de docker-compose.override.yml.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Las variables del SRI, IA y correo se agregarán en sus sprints.

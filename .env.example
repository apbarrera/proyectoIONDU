# ============================================================
# IONDU · Variables de entorno (PLANTILLA, sin secretos)
# - En local: copiar a .env (está en .gitignore).
# - En producción: se cargan en el panel del despliegue (Coolify u otro).
# ============================================================

# ---------- Angular (solo build) ----------
NG_BUILD_CONFIGURATION=production
NG_APP_NAME=iondu-app

# ---------- Backend ----------
# production | development (en development se habilita /api/docs)
APP_ENV=production
LOG_LEVEL=info
# Solo si se usa `ng serve` contra la API; en producción todo es mismo origen.
CORS_ORIGINS=

# ---------- PostgreSQL local (solo desarrollo, docker-compose.override.yml) ----------
# Obligatoria en local. Cualquier valor sin caracteres especiales, por ejemplo
# uno generado con: python -c "import secrets; print(secrets.token_hex(16))"
# Desde la computadora se conecta en localhost:15432 (usuario y base: iondu).
POSTGRES_PASSWORD=

# ---------- Base de datos (Supabase en producción) ----------
# Usar el Session Pooler (puerto 5432):
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Conexión exclusiva del usuario de ejecución de la API (iondu_app), sin privilegios
# de administrador y sujeta a RLS.
# EN LOCAL, igual que en producción: la API como iondu_app, el worker como iondu_worker
# y las migraciones como iondu (el administrador del PostgreSQL de Docker). Las
# contraseñas de iondu_app e iondu_worker se eligen aquí y se aplican con
#   docker compose run --rm --no-deps api python -m scripts.configurar_roles_locales
# después de `alembic upgrade head`. Ejemplos:
# DATABASE_URL=postgresql+psycopg://iondu_app:<clave>@db:5432/iondu
# WORKER_DATABASE_URL=postgresql+psycopg://iondu_worker:<otra clave>@db:5432/iondu
# MIGRATION_DATABASE_URL=postgresql+psycopg://iondu:<POSTGRES_PASSWORD>@db:5432/iondu
DATABASE_URL=

# ---------- Almacenamiento de archivos (API S3) ----------
# EN LOCAL: solo las dos credenciales (cualquier valor; el endpoint lo pone
# docker-compose.override.yml). Generar con: python -c "import secrets; print(secrets.token_hex(16))"
# EN PRODUCCIÓN: el endpoint S3 de Supabase Storage (https://<ref>.supabase.co/storage/v1/s3),
# su región y las llaves S3 del proyecto, o las de otro proveedor compatible.
# El bucket es privado y se crea al preparar el ambiente.
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=rides

# ---------- Inicio de sesión propio ----------
# Llave privada EC P-256 (PEM) con la que la API firma los tokens de acceso (ES256).
# Generar con: cd backend && python -m scripts.generar_llave_jwt
# En una sola línea, con "\n" en lugar de los saltos de línea. Cada ambiente tiene la suya;
# si se cambia, todas las sesiones abiertas se cierran. Nunca la subas al repositorio.
AUTH_JWT_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# ---------- Agente de IA (API compatible con OpenAI) ----------
# EN LOCAL con Ollama (https://ollama.com) instalado en la computadora:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1  y  ollama pull qwen2.5:7b
# EN PRODUCCIÓN: la URL /v1 del proveedor, su modelo y su clave (LLM_API_KEY).
# Vacío: el agente responde que no está configurado.
LLM_BASE_URL=
LLM_MODEL=qwen2.5:7b
# Lectura de fotos de facturas y tickets (en local: ollama pull qwen2.5vl:7b).
# Vacío: el agente solo acepta texto.
LLM_VISION_MODEL=
# Mensajes de voz: servicio de transcripción con la API de OpenAI.
# EN LOCAL: COMPOSE_PROFILES=ia levanta el servicio "stt" (Whisper en CPU) y
#   STT_BASE_URL=http://stt:8000/v1
# EN PRODUCCIÓN: p. ej. https://api.openai.com/v1, STT_MODEL=whisper-1 y STT_API_KEY.
# Vacío: el agente no acepta audio.
COMPOSE_PROFILES=
STT_BASE_URL=
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---------- Cifrado de certificados .p12 y credenciales ----------
# 32 bytes en base64. Generar con: cd backend && python -m app.core.cifrado
# Cada ambiente (local, staging, producción) tiene su propia llave.
# SI SE PIERDE, SE PIERDEN LOS CERTIFICADOS GUARDADOS: respáldala
# en un gestor de contraseñas. Nunca la subas al repositorio.
MASTER_ENCRYPTION_KEY=

# ---------- SRI simulado (demostración sin certificado .p12) ----------
# Ids de empresa separados por comas (p. ej., 1). Para esas empresas, y SOLO si están en
# ambiente de pruebas, la factura se firma con un certificado de prueba y se "autoriza"
# sin enviarla al SRI; el RIDE dice "SIMULADO - SIN VALIDEZ TRIBUTARIA".
# En producción (ambiente 2) no tiene efecto. Vaciarla cuando la empresa suba su .p12.
SRI_SIMULADO_EMPRESAS=

# ---------- Correo saliente (recuperación de contraseña e invitaciones) ----------
# Cualquier servidor SMTP. Vacío: no se envían correos y los usuarios nuevos reciben
# una contraseña temporal. En local, Mailpit (bandeja en http://localhost:8025):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=IONDU <no-responder@iondu.ec>
# Dirección pública de la app, para los enlaces de los correos (sin "/" final).
APP_PUBLIC_URL=http://localhost:8080

# ---------- Conexiones del worker y de las migraciones ----------
# En producción cada una con su propio usuario (iondu_worker, iondu_migrator):
# no reutilizar DATABASE_URL. En local, ver la nota de DATABASE_URL.
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=

# ---------- Solo desarrollo (APP_ENV=development) ----------
# Usuario con el que actúa la API cuando no hay token (Swagger, pruebas manuales).
# backend/scripts/cargar_datos_demo.py crea el Admin Demo con este id.
DEV_USER_ID=

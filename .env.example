# ============================================================
# IONDU · Variables de entorno (PLANTILLA, sin secretos)
# - En local: copiar a .env (está en .gitignore).
# - En producción: se cargan en el panel del despliegue (Coolify u otro).
# ============================================================

# ---------- Angular (solo build) ----------
NG_BUILD_CONFIGURATION=production
NG_APP_NAME=iondu-app

# ---------- Backend ----------
# production | development (en development se habilita /api/docs)
APP_ENV=production
LOG_LEVEL=info
# Solo si se usa `ng serve` contra la API; en producción todo es mismo origen.
CORS_ORIGINS=

# ---------- PostgreSQL local (solo desarrollo, docker-compose.override.yml) ----------
# Obligatoria en local. Cualquier valor sin caracteres especiales, por ejemplo
# uno generado con: python -c "import secrets; print(secrets.token_hex(16))"
# Desde la computadora se conecta en localhost:15432 (usuario y base: iondu).
POSTGRES_PASSWORD=

# ---------- Supabase (se completan en el Sprint 1) ----------
# Usar el Session Pooler (puerto 5432):
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Conexión exclusiva del usuario de ejecución de la API (iondu_app en producción).
# EN LOCAL, las tres conexiones (DATABASE_URL, WORKER_DATABASE_URL y
# MIGRATION_DATABASE_URL) pueden usar el PostgreSQL de Docker con el usuario iondu:
# postgresql+psycopg://iondu:<POSTGRES_PASSWORD>@db:5432/iondu
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Inicio de sesión propio ----------
# Llave privada EC P-256 (PEM) con la que la API firma los tokens de acceso (ES256).
# Generar con: cd backend && python -m scripts.generar_llave_jwt
# En una sola línea, con 
 en lugar de los saltos de línea. Cada ambiente tiene la suya;
# si se cambia, todas las sesiones abiertas se cierran. Nunca la subas al repositorio.
AUTH_JWT_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# ---------- Cifrado de certificados .p12 y credenciales ----------
# 32 bytes en base64. Generar con: cd backend && python -m app.core.cifrado
# Cada ambiente (local, staging, producción) tiene su propia llave.
# SI SE PIERDE, SE PIERDEN LOS CERTIFICADOS GUARDADOS: respáldala
# en un gestor de contraseñas. Nunca la subas al repositorio.
MASTER_ENCRYPTION_KEY=
# Las variables del SRI, IA y correo se agregarán en sus sprints.

# ---------- Conexiones del worker y de las migraciones ----------
# En producción cada una con su propio usuario (iondu_worker, iondu_migrator):
# no reutilizar DATABASE_URL. En local, ver la nota de DATABASE_URL.
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=

# ---------- Solo desarrollo (APP_ENV=development) ----------
# Usuario con el que actúa la API cuando no hay token (Swagger, pruebas manuales).
# backend/scripts/cargar_datos_demo.py crea el Admin Demo con este id.
DEV_USER_ID=
